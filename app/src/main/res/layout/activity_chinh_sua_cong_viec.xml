<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp"
    android:paddingTop="36dp"
    android:fitsSystemWindows="true">

    <EditText
        android:id="@+id/etSuaTenCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Chỉnh sửa tên công việc" />

    <EditText
        android:id="@+id/etSuaMoTaCongViec"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="Chỉnh sửa mô tả công việc" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="Mức độ ưu tiên:"
        android:textSize="16sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/rgMucDoUuTien"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/rbThap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Thấp" />

        <RadioButton
            android:id="@+id/rbTrungBinh"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Trung bình" />

        <RadioButton
            android:id="@+id/rbCao"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Cao" />
    </RadioGroup>

    <Button
        android:id="@+id/btnLuuChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Lưu thay đổi" />

</LinearLayout>