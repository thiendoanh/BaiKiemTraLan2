<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/tvTieuDe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="DANH SÁCH CÔNG VIỆC"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textColor="#1976D2"
        android:layout_marginBottom="16dp" />

    <!-- Thẻ chứa thông tin chi tiết công việc -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="16dp"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvTenCongViec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên công việc: "
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <TextView
            android:id="@+id/tvMoTaCongViec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mô tả: "
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbHoanThanh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Đánh dấu đã hoàn thành"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvTrangThai"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Trạng thái: Chưa hoàn thành"
            android:textSize="16sp"
            android:textStyle="italic"
            android:textColor="#D32F2F" />

    </LinearLayout>

    <Button
        android:id="@+id/btnChinhSua"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Chỉnh sửa công việc này" />

    <Button
        android:id="@+id/btnQuayLai"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Quay lại Màn hình chính"
        android:backgroundTint="#616161" />

</LinearLayout>